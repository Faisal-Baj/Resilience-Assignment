# PostgreSQL connection.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/remediation_workspace"

# Secret used to sign access tokens (HS256). Must be at least 32 characters.
JWT_SECRET="long-random-secret"

# Password given to every seeded demo account (at least 12 characters).
SEED_PASSWORD="replace-with-a-demo-password"

# The URL the browser uses to open the app.
APP_ORIGIN="http://localhost:3000"
PORT=3000

# Set to true when the app is served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Timezone used.
APP_TIMEZONE="Asia/Riyadh"
